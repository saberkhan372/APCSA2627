#!/bin/sh
# Pushing to main publishes docs/ immediately (GitHub Pages deploys from the branch without running
# any checks). This hook verifies the exact commit being pushed to main, checked out in a temporary
# worktree, so uncommitted or ignored files in your working copy cannot affect the result.
# Enable once per clone:   git config core.hooksPath tools/hooks
# It is a local safeguard only: it can be skipped (git push --no-verify) and does not run for other clones.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue   # deleting main: nothing to verify
  tmp=$(mktemp -d)
  if ! git worktree add --detach --quiet "$tmp" "$local_sha" 2>/dev/null; then
    echo "Push stopped: could not check out $local_sha to verify it." >&2
    status=1
    continue
  fi
  if out=$(cd "$tmp" && python3 tools/verify_pages.py 2>&1); then
    echo "pre-push: verified commit $(git rev-parse --short "$local_sha") for main." >&2
  else
    echo "Push stopped: tools/verify_pages.py failed for commit $(git rev-parse --short "$local_sha"), which is what would be published." >&2
    echo "$out" | grep -E "FAIL|Unexpected|Private|Error|error" | head -8 >&2
    status=1
  fi
  git worktree remove --force "$tmp"
done
exit $status
